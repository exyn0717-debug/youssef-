ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_DAILY_LIMIT=40
CLAUDE_MAX_TOKENS=1500
CLAUDE_TIMEOUT_SECONDS=75
