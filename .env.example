# Copy to .env and edit. Never commit real secrets.
METHOD_ENV=production
METHOD_PUBLIC_ORIGIN=https://study.example.com
METHOD_ALLOWED_ORIGINS=https://study.example.com
METHOD_COOKIE_SECURE=1
METHOD_COOKIE_SAMESITE=strict
# METHOD_DATA_DIR=/var/lib/eng-youssef
